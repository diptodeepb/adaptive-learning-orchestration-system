# LLM Provider Keys
# Get Groq Key here: https://console.groq.com/keys (Used for Pedagogical Agent)
GROQ_API_KEY="your_groq_api_key_here"

# Get Mistral Key here: https://console.mistral.ai/api-keys/ (Used for Orchestrator Agent)
MISTRAL_API_KEY="your_mistral_api_key_here"

# Get OpenRouter Key here: https://openrouter.ai/keys (Optional, for experimental models)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Database (Supabase) Keys - For later
# Get these from your Supabase Project Settings -> API
SUPABASE_URL="your_supabase_project_url"
SUPABASE_KEY="your_supabase_anon_key"

# Hugging Face Token (Used for fetching aggregated datasets)
# Get this from your Hugging Face Settings -> Access Tokens
HF_TOKEN="your_hugging_face_token_here"
